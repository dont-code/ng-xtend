{
  "name": "dc-workflow",
  "version": "1.4.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "APP=dc-workflow && ng build $APP",
    "build-deploy": "APP=dc-workflow && ng build $APP --configuration=$BUILD",
    "watch": "APP=dc-workflow && ng build $APP --watch --configuration development",
    "test": "ng test dc-workflow && ng test wfw-tester"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "repository": {
    "url": "https://github.com/dont-code/ng-xtend.git"
  },
  "publishConfig": {
    "directory": "dist/dc-workflow",
    "linkDirectory": true
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "22.2.6",
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/platform-browser-dynamic": "22.2.6",
    "@angular/router": "22.2.6",
    "@angular/cdk": "22.2.7",
    "rxjs": "^7.8.2",
    "@openng/optimus-ui": "2.0.2",
    "@openng/optimus-ui-themes": "2.0.2",
    "primeicons": "7.0.0",
    "tslib": "^2.8.1",
    "xt-type": "workspace:^",
    "xt-store": "workspace:^",
    "xt-components": "workspace:^",
    "@ngrx/signals": "22.0.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "happy-dom": "^20.8.9",
    "jsdom": "^29.0.1",
    "ng-packagr": "22.2.6",
    "typescript": "6.0.3",
    "vitest": "^4.1.2",
    "@openng/optimus-ui-styles": "2.0.2",
    "@openng/optimus-ui-styled": "2.0.2",
    "@openng/optimus-ui-utils": "2.0.2",
    "@openng/optimus-ui-motion": "2.0.2"
  }
}
