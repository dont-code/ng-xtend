{
  "name": "xt-components",
  "version": "1.5.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build xt-components --configuration=development && ng build tester-app --configuration=development ",
    "build-deploy": "APP=xt-components && ng build $APP --configuration=$BUILD",
    "watch": "ng build --watch --configuration development",
    "test": "ng test xt-components && ng test tester-app"
  },
  "repository": {
    "url": "https://github.com/dont-code/ng-xtend.git"
  },
  "publishConfig": {
    "directory": "dist/xt-components",
    "linkDirectory": true
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "22.2.6",
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/platform-browser-dynamic": "22.2.6",
    "@angular/router": "22.2.6",
    "@angular/cdk": "22.2.7",
    "rxjs": "^7.8.2",
    "@openng/optimus-ui": "2.0.2",
    "xt-type": "workspace:^",
    "@openng/optimus-ui-themes": "2.0.2",
    "primeicons": "7.0.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@types/node": "^24.12.2",
    "ng-packagr": "22.2.6",
    "typescript": "6.0.3",
    "happy-dom": "^20.8.9",
    "jsdom": "^29.0.1",
    "vitest": "^4.1.2",
    "prettier": "^3.8.1",
    "@openng/optimus-ui-utils": "2.0.2",
    "@openng/optimus-ui-styles": "2.0.2",
    "@openng/optimus-ui-styled": "2.0.2",
    "@openng/optimus-ui-motion": "2.0.2"
  }
}
