{
  "name": "xt-store",
  "version": "1.5.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-deploy": "APP=store && ng build $APP --configuration=$BUILD",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "publishConfig": {
    "directory": "dist/store",
    "linkDirectory": true
  },
  "repository": {
    "url": "https://github.com/dont-code/ng-xtend.git"
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "22.2.6",
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/platform-browser-dynamic": "22.2.6",
    "@angular/router": "22.2.6",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "@ngrx/signals": "22.0.1",
    "xt-type": "workspace:^"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "happy-dom": "^20.8.9",
    "ng-packagr": "22.2.6",
    "typescript": "6.0.3",
    "@types/node": "^24.12.2",
    "jsdom": "^29.0.1",
    "vitest": "^4.1.2"
  }
}
