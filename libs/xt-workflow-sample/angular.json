{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"newProjectRoot": "projects",
	"cli": {
		"cache": {
			"enabled": true
    },
    "analytics": "7e94255a-a5b8-4a20-9312-8b6d123f49b2"
	},
	"projects": {
		"workflow-sample": {
			"projectType": "library",
			"root": "projects/lib",
			"sourceRoot": "projects/lib/src",
			"prefix": "lib",
			"architect": {
				"build": {
					"builder": "@angular/build:ng-packagr",
					"configurations": {
						"production": {
							"tsConfig": "projects/lib/tsconfig.lib.prod.json"
						},
						"next": {
							"tsConfig": "projects/lib/tsconfig.lib.next.json"
						},
						"development": {
							"tsConfig": "projects/lib/tsconfig.lib.json"
						}
					},
					"defaultConfiguration": "development"
				},
				"test": {
					"builder": "@angular/build:unit-test",
					"options": {
						"tsConfig": "projects/lib/tsconfig.spec.json"
					}
				}
			}
		},
		"workflow-sample-plugin": {
			"projectType": "application",
			"schematics": {},
			"root": "projects/plugin",
			"sourceRoot": "projects/plugin/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular-architects/native-federation:build",
					"options": {},
					"configurations": {
						"production": {
							"target": "workflow-sample-plugin:esbuild:production"
						},
						"next": {
							"target": "workflow-sample-plugin:esbuild:next",
							"dev": true
						},
						"development": {
							"target": "workflow-sample-plugin:esbuild:development",
							"dev": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@angular-architects/native-federation:build",
					"options": {
						"target": "workflow-sample-plugin:serve-original:development",
						"rebuildDelay": 0,
						"dev": true,
						"cacheExternalArtifacts": false,
						"port": 0
					}
				},
				"test": {
					"builder": "@angular/build:unit-test",
					"options": {
						"buildTarget": "workflow-sample-plugin:esbuild:development"
					}
				},
				"esbuild": {
					"builder": "@angular/build:application",
					"options": {
						"outputPath": "dist/workflow-sample-plugin",
						"index": "projects/plugin/src/index.html",
						"browser": "projects/plugin/src/main.ts",
						"preserveSymlinks": true,
						"polyfills": [
							"es-module-shims"
						],
						"tsConfig": "projects/plugin/tsconfig.app.json",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/plugin/public"
							}
						],
						"styles": [
							"projects/plugin/src/styles.css"
						]
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "1MB",
									"maximumError": "2MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError": "8kB"
								}
							],
							"outputHashing": "all"
						},
						"next": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "development"
				},
				"serve-original": {
					"builder": "@angular/build:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "workflow-sample-plugin:esbuild:production"
						},
						"development": {
							"buildTarget": "workflow-sample-plugin:esbuild:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"port": 4201
					}
				}
			}
		}
	}
}
