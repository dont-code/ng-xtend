    "@primeuix/utils": "^0.7.1",
    "@primeuix/styled": "^0.7.2",
    "@angular-devkit/build-angular": "^21.2.6",
    "@angular/cli": "^21.2.6",
    "@angular/build": "^21.2.6",
    "@angular/compiler-cli": "^21.2.7",
    "@types/node": "^24.12.2",
    "ng-packagr": "^21.2.2",
    "typescript": "^5.9.3",
    "jsdom": "^29.0.1",
    "vitest": "^4.1.2",
    "happy-dom": "^20.8.9",
    "@tailwindcss/postcss": "~4.2.2",
    "postcss": "~8.5.6",
