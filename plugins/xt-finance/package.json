{
  "name": "xt-plugin-finance",
  "version": "1.4.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build finance",
    "build-deploy": "APP=finance-plugin && MAIN_LIB=finance && ng build $MAIN_LIB --configuration=$BUILD && ng build $APP --configuration=$BUILD --output-path=\"../../dist/$STAGE/$APP\" --base-href=\"https://dont-code.net/apps/$STAGE/$APP/\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test finance && ng test finance-plugin"
  },
  "publishConfig": {
    "directory": "dist/xt-plugin-finance",
    "linkDirectory": true
  },
  "repository": {
    "url": "https://github.com/dont-code/ng-xtend.git"
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "22.2.6",
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/platform-browser-dynamic": "22.2.6",
    "@angular/router": "22.2.6",
    "@angular/cdk": "22.2.7",
    "xt-components": "workspace:^",
    "xt-type": "workspace:^",
    "rxjs": "^7.8.2",
    "@openng/optimus-ui": "2.0.2",
    "primeicons": "7.0.0",
    "@openng/optimus-ui-themes": "2.0.2",
    "tslib": "^2.8.1",
    "tailwindcss": "~4.2.2",
    "es-module-shims": "^2.8.0",
    "@softarc/native-federation-runtime": "^3.5.6"
  },
  "devDependencies": {
    "@angular-architects/native-federation": "22.2.5",
    "@openng/optimus-ui-utils": "2.0.2",
    "@openng/optimus-ui-styled": "2.0.2",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@angular/build": "22.2.7",
    "ng-packagr": "22.2.6",
    "typescript": "6.0.3",
    "@types/node": "^24.12.2",
    "jsdom": "^29.0.1",
    "vitest": "^4.1.2",
    "happy-dom": "^20.8.9",
    "@tailwindcss/postcss": "~4.2.2",
    "postcss": "~8.5.6",
    "@softarc/native-federation": "^4.10.0",
    "@softarc/native-federation-orchestrator": "^4.10.0",
    "@openng/optimus-ui-styles": "2.0.2",
    "@openng/optimus-ui-motion": "2.0.2"
  }
}
