{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "prerelease": true,
    "prerelease-type": "next",
    "packages": {
        ".": {
            "release-type": "simple",
            "package-name": "ng-xtend",
            "changelog-path": "CHANGELOG.md"
        },
        "libs/xt-type": {
            "release-type": "node",
            "package-name": "xt-type",
            "extra-files": [
                "jsr.json"
            ],
            "prerelease": false
        },
        "libs/xt-store": {
            "release-type": "node",
            "package-name": "xt-store",
            "extra-files": [
                "projects/store/package.json"
            ]
        },
        "plugins/xt-idb-store": {
            "release-type": "node",
            "package-name": "xt-idb-store",
            "extra-files": [
                "projects/idb-store/package.json"
            ]
        },
        "libs/xt-components": {
            "release-type": "node",
            "package-name": "xt-components",
            "extra-files": [
                "projects/xt-components/package.json"
            ]
        },
        "libs/dc-workflow": {
            "release-type": "node",
            "package-name": "dc-workflow",
            "extra-files": [
                "projects/dc-workflow/package.json"
            ]
        },
        "libs/xt-plugin-sample": {
            "release-type": "node",
            "package-name": "xt-plugin-sample",
            "extra-files": [
                "projects/sample/package.json"
            ]
        },
        "libs/xt-workflow-sample": {
            "release-type": "node",
            "package-name": "xt-workflow-sample",
            "extra-files": [
                "projects/workflow-sample/package.json"
            ]
        },
        "plugins/xt-default": {
            "release-type": "node",
            "package-name": "xt-plugin-default",
            "extra-files": [
                "projects/default/package.json"
            ]
        },
        "plugins/xt-intl": {
            "release-type": "node",
            "package-name": "xt-plugin-intl",
            "extra-files": [
                "projects/intl/package.json"
            ]
        },
        "plugins/xt-finance": {
            "release-type": "node",
            "package-name": "xt-plugin-finance",
            "extra-files": [
                "projects/finance/package.json"
            ]
        },
        "plugins/xt-web": {
            "release-type": "node",
            "package-name": "xt-plugin-web",
            "extra-files": [
                "projects/web/package.json"
            ]
        },
        "plugins/xt-agenda": {
            "release-type": "node",
            "package-name": "xt-plugin-agenda",
            "extra-files": [
                "projects/agenda/package.json"
            ]
        },
        "plugins/xt-editor": {
            "release-type": "node",
            "package-name": "xt-plugin-editor",
            "extra-files": [
                "projects/editor/package.json"
            ]
        },
        "plugins/xt-workflow": {
            "release-type": "node",
            "package-name": "xt-plugin-workflow",
            "extra-files": [
                "projects/workflow/package.json"
            ]
        }
    },
    "plugins": [
        {
            "type": "linked-versions",
            "groupName": "xt-components",
            "components": [
                "xt-store",
                "xt-idb-store",
                "xt-components",
                "dc-workflow",
                "xt-plugin-sample",
                "xt-workflow-sample",
                "xt-plugin-default",
                "xt-plugin-intl",
                "xt-plugin-finance",
                "xt-plugin-web",
                "xt-plugin-agenda",
                "xt-plugin-workflow",
                "xt-editor"
            ]
        }
    ]
}
